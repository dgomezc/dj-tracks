# Copiar a .env. Las cinco carpetas deben existir en el host Ubuntu.
TRACKS_PATH=/srv/music/Tracks
SESSIONS_PATH=/srv/music/Sessions
REMEMBER_PATH=/srv/music/Remember
PLAYLISTS_PATH=/srv/dj-tracks/Playlists
SESSION_MARKS_PATH=/srv/dj-tracks/SessionMarks
UI_PORT=5050

# Generar con: openssl rand -hex 32
# Usar los 64 caracteres hexadecimales, sin espacios ni punto y coma.
POSTGRES_PASSWORD=

# Opcional: credenciales exclusivas para clientes Subsonic; no reutilizar contraseñas.
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=
