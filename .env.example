# Copiar a .env. Las cuatro carpetas deben existir en el host Ubuntu.
TRACKS_PATH=/srv/music/Tracks
SESSIONS_PATH=/srv/music/Sessions
REMEMBER_PATH=/srv/music/Remember
# La API crea playlists, session-marks y tracks-waves dentro de esta carpeta.
# Debe permitir lectura y escritura al UID 1654.
DJ_TRACKS_DATA_PATH=/srv/dj-tracks-data
UI_PORT=5050

# Generar con: openssl rand -hex 32
# Usar los 64 caracteres hexadecimales, sin espacios ni punto y coma.
POSTGRES_PASSWORD=

# Opcional: credenciales exclusivas para clientes Subsonic; no reutilizar contraseñas.
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=
