@inherits LayoutComponentBase
@implements IDisposable
@inject DjTracks.UI.Shared.AudioPlayerState AudioPlayer

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">DJ Tracks</MudText>
        <MudSpacer />
        <MudNavLink Href="/" Match="NavLinkMatch.All" Style="width:auto">Inicio</MudNavLink>
        <MudNavLink Href="/tracks" Style="width:auto">Tracks</MudNavLink>
        <MudNavLink Href="/sessions" Style="width:auto">Sessions</MudNavLink>
        <MudNavLink Href="/remember" Style="width:auto">Remember</MudNavLink>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Settings" Href="/settings" Color="Color.Inherit" />
    </MudAppBar>

    <MudDrawer Open="true" Variant="DrawerVariant.Persistent" Elevation="0" ClipMode="DrawerClipMode.Always" Width="260px">
        <MudNavMenu>
            <MudText Typo="Typo.overline" Class="px-4 mt-4">Playlists manuales</MudText>
            <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Sin playlists</MudText>
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.overline" Class="px-4">Playlists automáticos</MudText>
            <MudText Typo="Typo.body2" Class="px-4 mud-text-secondary">Sin playlists</MudText>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-content">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<footer class="player-bar">
    @if (AudioPlayer.AudioUrl is null)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">Selecciona una canción para reproducir</MudText>
    }
    else
    {
        <MudStack Spacing="0" Class="player-track">
            <MudText Typo="Typo.body2" Class="player-track-title">@AudioPlayer.Title</MudText>
            @if (!string.IsNullOrWhiteSpace(AudioPlayer.Artist))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary player-track-artist">@AudioPlayer.Artist</MudText>
            }
        </MudStack>
        <div class="player-controls">
            <WaveformPlayer WaveformUrl="@AudioPlayer.WaveformUrl" />
            <audio id="djtracks-audio" @key="AudioPlayer.AudioUrl" controls autoplay preload="metadata"
                   src="@AudioPlayer.AudioUrl" aria-label="Controles de reproducción"></audio>
        </div>
    }
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized() => AudioPlayer.Changed += OnPlayerChanged;

    private void OnPlayerChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => AudioPlayer.Changed -= OnPlayerChanged;
}
