@inherits LayoutComponentBase
@implements IDisposable
@inject DjTracks.UI.Shared.AudioPlayerState AudioPlayer

<BbPortalHost />

<header class="app-bar">
    <span class="app-title">DJ Tracks</span>
    <nav class="app-nav" aria-label="Secciones">
        <NavLink href="/" Match="NavLinkMatch.All" class="app-nav-link">Inicio</NavLink>
        <NavLink href="/tracks" class="app-nav-link">Tracks</NavLink>
        <NavLink href="/sessions" class="app-nav-link">Sessions</NavLink>
        <NavLink href="/remember" class="app-nav-link">Remember</NavLink>
        <NavLink href="/playlists" class="app-nav-link">Playlists</NavLink>
    </nav>
    <div class="app-actions">
        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => _queueOpen = !_queueOpen" AriaLabel="Abrir cola">
            <Icon><LucideIcon Name="list-music" /></Icon>
            <ChildContent>Cola (@AudioPlayer.Queue.Count)</ChildContent>
        </BbButton>
        <BbTooltip DelayDuration="300">
            <BbTooltipTrigger AsChild="true">
                <BbDarkModeToggle LightLabel="Modo claro" DarkLabel="Modo oscuro" aria-label="Cambiar entre modo claro y oscuro" />
            </BbTooltipTrigger>
            <BbTooltipContent>Cambiar entre modo claro y oscuro</BbTooltipContent>
        </BbTooltip>
        <IconButton Label="Configuración" Icon="settings" Href="/settings" />
    </div>
</header>

<div class="app-body">
    <aside class="library-panel" aria-label="Playlists">
        <PlaylistSidebar />
    </aside>

    <main class="main-content">
        <NowPlaying />
        @Body
    </main>
</div>
<PlaybackQueue @bind-Open="_queueOpen" />

<footer class="player-bar">
    <div class="queue-controls">
        <IconButton Label="Canción anterior" Icon="skip-back" OnClick="AudioPlayer.Previous"
                    Disabled="@(!AudioPlayer.CanPrevious)" />
        <IconButton Label="Canción siguiente" Icon="skip-forward" OnClick="AudioPlayer.Next"
                    Disabled="@(!AudioPlayer.CanNext)" />
        <IconButton Label="@(AudioPlayer.Shuffle ? "Desactivar reproducción aleatoria" : "Activar reproducción aleatoria")"
                    AriaLabel="Reproducción aleatoria" Icon="shuffle" OnClick="AudioPlayer.ToggleShuffle"
                    Variant="@(AudioPlayer.Shuffle ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    aria-pressed="@AudioPlayer.Shuffle.ToString().ToLowerInvariant()" />
        <BbButton Variant="@(AudioPlayer.Repeat == DjTracks.UI.Shared.QueueRepeatMode.Off ? ButtonVariant.Ghost : ButtonVariant.Secondary)"
                  OnClick="AudioPlayer.CycleRepeat" AriaLabel="Cambiar modo de bucle">
            @RepeatLabel
        </BbButton>
    </div>
    @if (AudioPlayer.AudioUrl is null)
    {
        <BbTypographyMuted>Selecciona una canción para reproducir</BbTypographyMuted>
    }
    else
    {
        <div class="player-track">
            <div class="player-track-title">@AudioPlayer.Title</div>
            @if (!string.IsNullOrWhiteSpace(AudioPlayer.Artist))
            {
                <div class="player-track-artist">@AudioPlayer.Artist</div>
            }
        </div>
        var playbackVersion = AudioPlayer.PlaybackVersion;
        <div class="player-controls" @key="playbackVersion">
            @if (AudioPlayer.WaveformUrl is not null)
            {
                <WaveformPlayer WaveformUrl="@AudioPlayer.WaveformUrl" />
            }
            <audio id="djtracks-audio" controls autoplay preload="metadata"
                   src="@AudioPlayer.AudioUrl" aria-label="Controles de reproducción"
                   @onended="() => AudioPlayer.OnEnded(playbackVersion)"></audio>
        </div>
    }
</footer>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _queueOpen;
    private string RepeatLabel => AudioPlayer.Repeat switch
    {
        DjTracks.UI.Shared.QueueRepeatMode.All => "Bucle: cola",
        DjTracks.UI.Shared.QueueRepeatMode.One => "Bucle: canción",
        _ => "Bucle: no"
    };

    protected override void OnInitialized() => AudioPlayer.Changed += OnPlayerChanged;

    private void OnPlayerChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => AudioPlayer.Changed -= OnPlayerChanged;
}
