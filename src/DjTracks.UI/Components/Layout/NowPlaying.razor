@implements IDisposable

<BbCard Class="now-playing" role="region" aria-label="Ahora suena">
    <BbCardHeader><BbCardTitle>Ahora suena</BbCardTitle></BbCardHeader>
    <BbCardContent>
    @if (Player.Current is { } current)
    {
        <div class="now-playing-content">
            <div class="now-playing-artwork">
                @if (_dataUrl is not null && _error is null)
                {
                    var dataUrl = _dataUrl;
                    <img @key="dataUrl" src="@dataUrl" alt="@($"Carátula de {current.Title}")"
                         @onerror="() => OnImageError(dataUrl)" />
                }
                else
                {
                    <LucideIcon Name="disc-3" Size="40" />
                    <span class="text-small" role="status">
                        @(_loading ? "Cargando carátula…" : _error is null ? "Sin carátula" : "Carátula no disponible")
                    </span>
                }
            </div>
            <div class="now-playing-details">
                <h3 class="now-playing-title">@current.Title</h3>
                <div>Artista: @Display(current.Artist)</div>
                <div>Álbum: @Display(current.Details.Album)</div>
                <div>Año (carpeta): @Display(current.Details.Year)</div>
                <div>Estilo (carpeta): @Display(current.Details.Style)</div>
                <div>Duración: @Duration(current.Details.DurationSeconds)</div>
                <div class="text-small">Fichero: @current.Details.FileName</div>
                @if (current.Details.Warning is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription>@current.Details.Warning</BbAlertDescription></BbAlert>
                }
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription>@_error</BbAlertDescription></BbAlert>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="ReloadAsync">Reintentar carátula</BbButton>
                }
            </div>
        </div>
    }
    else
    {
        <p class="text-muted">Selecciona una canción para ver su carátula e información.</p>
    }
    </BbCardContent>
</BbCard>
