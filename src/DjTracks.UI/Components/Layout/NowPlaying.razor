@implements IDisposable

@if (Compact)
{
    <div class="player-track-info">
        <div class="player-artwork">
            @if (_dataUrl is not null && _error is null)
            {
                var dataUrl = _dataUrl;
                <img @key="dataUrl" src="@dataUrl" alt="@($"Carátula de {Player.Title}")"
                     @onerror="() => OnImageError(dataUrl)" />
            }
            else
            {
                <LucideIcon Name="disc-3" Size="30" />
                <span>@(_loading ? "Cargando…" : _error is null ? "Sin carátula" : "No disponible")</span>
            }
        </div>
        <div class="player-track">
            <div class="player-track-title" title="@Player.Title">@(Player.Title ?? "Selecciona una canción")</div>
            <div class="player-track-artist" title="@Player.Artist">
                @(Player.Current is null ? "Tracks · Sessions · Remember" : Display(Player.Artist))
            </div>
            @if (Player.Current is { } current)
            {
                <div class="player-track-tags">
                    <span class="player-style" title="@(current.SessionFolder ?? current.RememberCategory ?? current.Details.Style)">
                        @(current.SessionFolder is not null ? "Session" : current.RememberCategory is not null
                            ? $"Remember · {current.RememberCategory}" : Display(current.Details.Style))
                    </span>
                    @if (current.Details.Year is not null)
                    {
                        <span>@current.Details.Year</span>
                    }
                </div>
            }
            @if (_error is not null)
            {
                <span class="player-artwork-error" title="@_error" role="status">Carátula no disponible</span>
            }
        </div>
    </div>
}
else
{
<BbCard Class="now-playing" role="region" aria-label="Ahora suena">
    <BbCardHeader><BbCardTitle>Ahora suena</BbCardTitle></BbCardHeader>
    <BbCardContent>
    @if (Player.Current is { } current)
    {
        <div class="now-playing-sections">
        <div class="now-playing-content">
            <div class="now-playing-artwork">
                @if (_dataUrl is not null && _error is null)
                {
                    var dataUrl = _dataUrl;
                    <img @key="dataUrl" src="@dataUrl" alt="@($"Carátula de {current.Title}")"
                         @onerror="() => OnImageError(dataUrl)" />
                }
                else
                {
                    <LucideIcon Name="disc-3" Size="40" />
                    <span class="text-small" role="status">
                        @(_loading ? "Cargando carátula…" : _error is null ? "Sin carátula" : "Carátula no disponible")
                    </span>
                }
            </div>
            <div class="now-playing-details">
                <h3 class="now-playing-title">@current.Title</h3>
                <div>Artista: @Display(current.Artist)</div>
                <div>Álbum: @Display(current.Details.Album)</div>
                @if (current.RememberCategory is not null)
                {
                    <div>Remember (carpeta): @current.RememberCategory</div>
                }
                else
                {
                    <div>Año (carpeta): @Display(current.Details.Year)</div>
                }
                @if (current.SessionFolder is not null)
                {
                    <div>Sesión (carpeta): @current.SessionFolder</div>
                }
                else if (current.RememberCategory is null)
                {
                    <div>Estilo (carpeta): @Display(current.Details.Style)</div>
                }
                <div>Duración: @Duration(current.Details.DurationSeconds)</div>
                <div class="text-small">Fichero: @current.Details.FileName</div>
                @if (current.Details.Warning is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription>@current.Details.Warning</BbAlertDescription></BbAlert>
                }
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription>@_error</BbAlertDescription></BbAlert>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="ReloadAsync">Reintentar carátula</BbButton>
                }
            </div>
        </div>
        <SessionTracklistPanel Url="@current.TracklistUrl" />
        </div>
    }
    else
    {
        <p class="text-muted">Selecciona una canción para ver su carátula e información.</p>
    }
    </BbCardContent>
</BbCard>
}
