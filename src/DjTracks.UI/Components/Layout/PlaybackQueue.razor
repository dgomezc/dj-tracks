@using DjTracks.UI.Shared
@implements IDisposable
@inject AudioPlayerState Player

<BbSheet Open="@Open" OpenChanged="@OpenChanged">
    <BbSheetContent Side="SheetSide.Right" Class="playback-queue">
        <BbSheetHeader>
            <BbSheetTitle>Cola (@Player.Queue.Count)</BbSheetTitle>
            <BbSheetDescription>Canciones pendientes de reproducir.</BbSheetDescription>
        </BbSheetHeader>
        <div class="queue-actions">
            <BbButton Variant="ButtonVariant.Outline" OnClick="Player.Clear" Disabled="@(Player.Queue.Count == 0)">
                Vaciar cola
            </BbButton>
        </div>
        @if (Player.Queue.Count == 0)
        {
            <p class="queue-empty" role="status">La cola está vacía. Añade canciones desde Tracks.</p>
        }
        <div class="queue-list">
            @foreach (var track in Player.Queue)
            {
                var isCurrent = Player.Current?.Id == track.Id;
                <div @key="track.Id" class="queue-entry">
                    <BbButton Variant="@(isCurrent ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Icon"
                              OnClick="() => Player.PlayQueued(track.Id)"
                              AriaLabel="@($"Reproducir de la cola {track.Title}")">
                        <LucideIcon Name="@(isCurrent ? "audio-lines" : "play")" />
                    </BbButton>
                    <div class="queue-entry-text">
                        <div class="queue-entry-title">@track.Title</div>
                        <div class="text-muted text-small">@track.Artist</div>
                    </div>
                    <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                              OnClick="() => Player.Remove(track.Id)"
                              AriaLabel="@($"Quitar de la cola {track.Title}")">
                        <LucideIcon Name="trash-2" />
                    </BbButton>
                </div>
            }
        </div>
    </BbSheetContent>
</BbSheet>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    protected override void OnInitialized() => Player.Changed += OnPlayerChanged;

    private void OnPlayerChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Player.Changed -= OnPlayerChanged;
}
