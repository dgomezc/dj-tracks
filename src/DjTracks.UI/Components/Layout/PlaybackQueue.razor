@using DjTracks.UI.Shared
@inject AudioPlayerState Player

<MudDrawer Open="@Open" OpenChanged="@OpenChanged" Anchor="Anchor.Right" Variant="DrawerVariant.Temporary"
           Width="340px" Class="playback-queue">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="pa-3">
        <MudText Typo="Typo.h6">Cola (@Player.Queue.Count)</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseAsync"
                       aria-label="Cerrar cola" />
    </MudStack>
    <MudButton OnClick="Player.Clear" Disabled="@(Player.Queue.Count == 0)" Class="ma-3">
        Vaciar cola
    </MudButton>
    @if (Player.Queue.Count == 0)
    {
        <MudText Class="pa-4" role="status">La cola está vacía. Añade canciones desde Tracks.</MudText>
    }
    @foreach (var track in Player.Queue)
    {
        <div @key="track.Id" class="queue-entry">
            <MudIconButton Icon="@(Player.Current?.Id == track.Id
                                    ? Icons.Material.Filled.GraphicEq : Icons.Material.Filled.PlayArrow)"
                           Color="@(Player.Current?.Id == track.Id ? Color.Primary : Color.Default)"
                           OnClick="() => Player.PlayQueued(track.Id)"
                           aria-label="@($"Reproducir de la cola {track.Title}")" />
            <div class="queue-entry-text">
                <MudText Typo="Typo.body2">@track.Title</MudText>
                <MudText Typo="Typo.caption">@track.Artist</MudText>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                           OnClick="() => Player.Remove(track.Id)"
                           aria-label="@($"Quitar de la cola {track.Title}")" />
        </div>
    }
</MudDrawer>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private Task CloseAsync() => OpenChanged.InvokeAsync(false);
}
