@implements IAsyncDisposable

@if (Url is not null)
{
    <section class="session-tracklist" aria-label="Tracklist de la sesión">
        <div class="button-row">
            <h4 class="section-title">Tracklist</h4>
            <BbButton Variant="ButtonVariant.Ghost" OnClick="ReloadAsync" Disabled="@_loading">Volver a cargar tracklist</BbButton>
        </div>
        @if (_loading)
        {
            <div class="busy-indicator" role="status">
                <BbSpinner Size="SpinnerSize.Small" AriaLabel="Cargando tracklist" />
                <span>Cargando tracklist…</span>
            </div>
        }
        else if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Warning">
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }
        else if (_tracklist?.FileName is null)
        {
            <p class="text-muted" role="status">No hay un TXT de tracklist compatible junto a esta sesión.</p>
        }
        else
        {
            <p class="file-name text-muted">Fichero: @_tracklist.FileName</p>
            @if (string.IsNullOrWhiteSpace(_tracklist.Content))
            {
                <p class="text-muted" role="status">El tracklist está vacío.</p>
            }
            else
            {
                @if (_marksError is not null)
                {
                    <BbAlert Variant="AlertVariant.Warning"><BbAlertDescription>@_marksError</BbAlertDescription></BbAlert>
                }
                @if (HasDuplicates)
                {
                    <p class="text-muted" role="status">Hay líneas duplicadas: no se pueden marcar ni usar sus marcas hasta que sean únicas.</p>
                }
                @if (OrphanCount > 0)
                {
                    <p class="text-muted" role="status">Hay @OrphanCount marcas de líneas que ya no están en el TXT. Se conservan por si restauras el texto original.</p>
                }
                <div class="tracklist-content session-mark-list" aria-label="Contenido del tracklist">
                    @foreach (var line in Lines)
                    {
                        var mark = _marks.FirstOrDefault(item => item.Line == line);
                        var enabled = _marksLoaded && !_saving && _module is not null
                            && !string.IsNullOrWhiteSpace(line) && !IsDuplicate(line);
                        <div class="session-mark-line">
                            @if (mark is not null && enabled)
                            {
                                <button type="button" class="session-mark-jump" @onclick="() => SeekAsync(mark.Seconds)">@line</button>
                                <span class="text-small">@FormatTime(mark.Seconds)</span>
                            }
                            else
                            {
                                <span class="session-mark-text">@line</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(line))
                            {
                                <BbButton Variant="ButtonVariant.Ghost"
                                          AriaLabel="@($"{(mark is null ? "Marcar" : "Sustituir marca de")} {line}")"
                                          Disabled="@(!enabled)" OnClick="() => SaveAsync(line, false)">
                                    @(mark is null ? "Marcar" : "Actualizar")
                                </BbButton>
                                @if (mark is not null)
                                {
                                    <BbButton Variant="ButtonVariant.Ghost" AriaLabel="@($"Borrar marca de {line}")"
                                              Disabled="@(!enabled)" OnClick="() => SaveAsync(line, true)">Borrar</BbButton>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    </section>
}
