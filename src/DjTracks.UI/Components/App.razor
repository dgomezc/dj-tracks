@using DjTracks.UI.Shared
<!DOCTYPE html>
<html lang="en" data-app-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist:wght@400;500;600;700&family=Afacad:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["theme.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BlazorBlueprint.Components/blazorblueprint.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DjTracks.UI.styles.css"]" />
    @* Aplica el modo guardado (o el del sistema) antes de pintar para evitar parpadeos. *@
    <script src="@Assets["_content/BlazorBlueprint.Components/js/theme-init.js"]"></script>
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // Se renderiza en el servidor para que el tema se aplique antes de pintar y no lo borre la navegación mejorada.
    private string _theme => AppThemes.Resolve(HttpContext?.Request.Cookies[AppThemes.CookieName]);
}