@using DjTracks.Domain
@using System.Text.Json
@using Microsoft.AspNetCore.Mvc
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<FolderPicker> Logger

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">
            Carpetas del servidor de la API, no del equipo del navegador.
            Seleccionar solo rellena el campo; después debes guardar las rutas.
        </MudText>
        <MudStack Spacing="2">
            <MudTextField T="string" Label="Ruta del servidor" @bind-Value="_path"
                          Variant="Variant.Outlined" Disabled="@_busy" Immediate="true"
                          HelperText="Puedes pegar una ruta absoluta, incluida una ruta de red UNC en Windows." />
            <MudStack Row="true" Wrap="Wrap.Wrap">
                <MudButton OnClick="() => NavigateAsync(_path)" Disabled="@_busy">Ir</MudButton>
                <MudButton OnClick="() => NavigateAsync(null)" Disabled="@_busy">Unidades / raíz</MudButton>
                <MudButton OnClick="() => NavigateAsync(_listing?.ParentPath)"
                           Disabled="@(_busy || _listing?.ParentPath is null)">Subir</MudButton>
            </MudStack>
            @if (_busy)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="Cargando carpetas" />
            }
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" role="alert">@_error</MudAlert>
            }
            @if (_listing is not null)
            {
                <MudText Typo="Typo.body2" Style="overflow-wrap:anywhere">
                    @(_listing.CurrentPath ?? "Unidades / raíz del servidor")
                </MudText>
                <div style="max-height:40vh;overflow-y:auto" aria-label="Carpetas disponibles">
                    <MudStack Spacing="1">
                        @foreach (var directory in _listing.Directories)
                        {
                            <MudButton OnClick="() => NavigateAsync(directory)" Disabled="@_busy"
                                       StartIcon="@Icons.Material.Filled.Folder" Style="justify-content:flex-start;text-transform:none;overflow-wrap:anywhere">
                                @directory
                            </MudButton>
                        }
                    </MudStack>
                </div>
                @if (_listing.Directories.Length == 0)
                {
                    <MudText Class="mud-text-secondary">Esta carpeta no contiene subcarpetas. Puedes seleccionarla.</MudText>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Dialog.Cancel">Cancelar</MudButton>
        <MudButton OnClick="SelectFolder" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(!CanSelect)">Seleccionar esta carpeta</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string InitialPath { get; set; } = "";

    private string? _path;
    private FolderListing? _listing;
    private string? _error;
    private bool _busy;
    private bool CanSelect => !_busy && _listing?.CurrentPath is { } path && path == _path;

    protected override Task OnInitializedAsync() => NavigateAsync(InitialPath);

    private async Task NavigateAsync(string? path)
    {
        _busy = true;
        _error = null;
        _listing = null;
        _path = path;
        try
        {
            using var client = HttpClientFactory.CreateClient("Api");
            var url = "api/settings/folders";
            if (!string.IsNullOrWhiteSpace(path))
                url += $"?path={Uri.EscapeDataString(path)}";
            using var response = await client.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                var problem = await response.Content.ReadFromJsonAsync<ProblemDetails>();
                _error = problem?.Detail ?? problem?.Title ?? $"La API devolvió un error ({(int)response.StatusCode}).";
                Logger.LogWarning("El selector de carpetas recibió HTTP {StatusCode}", (int)response.StatusCode);
                return;
            }
            _listing = await response.Content.ReadFromJsonAsync<FolderListing>()
                ?? throw new JsonException("Respuesta de carpetas vacía.");
            _path = _listing.CurrentPath;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or JsonException
            or NotSupportedException)
        {
            Logger.LogError(ex, "No se pudieron cargar las carpetas del servidor");
            _error = ex is JsonException or NotSupportedException
                ? "La API devolvió una respuesta no válida al consultar las carpetas."
                : "No se pudo contactar con la API o se agotó el tiempo de espera. Comprueba que está iniciada y vuelve a pulsar Ir o Unidades / raíz.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void SelectFolder()
    {
        if (CanSelect && _listing?.CurrentPath is { } path)
            Dialog.Close(DialogResult.Ok(path));
    }
}
