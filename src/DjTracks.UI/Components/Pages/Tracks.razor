@page "/tracks"
@using DjTracks.Domain

<PageTitle>Tracks - DJ Tracks</PageTitle>

<BbTypographyH2 Class="page-title">Tracks</BbTypographyH2>
<BbTypographyMuted Class="page-intro">Explora tu biblioteca por año y estilo.</BbTypographyMuted>

<BbCollapsible Open="@_filtersOpen" OpenChanged="OnFiltersExpandedAsync" Class="filters-panel">
    <BbCollapsibleTrigger>
        <BbButton Variant="ButtonVariant.Ghost" Class="filters-trigger">
            <Icon><LucideIcon Name="@(_filtersOpen ? "chevron-up" : "chevron-down")" /></Icon>
            <ChildContent>Filtros</ChildContent>
        </BbButton>
    </BbCollapsibleTrigger>
    <BbCollapsibleContent>
        <div class="filters-body">
            <div class="filters-grid">
                <BbField>
                    <BbFieldLabel>Años</BbFieldLabel>
                    <BbMultiSelect TValue="string" @bind-Values="_filterYears" AriaLabel="Años"
                                   Options="@(ToOptions(_filterOptions?.Years))" Placeholder="Todos los años"
                                   Disabled="@(_busy || _filterOptions is null)" MatchTriggerWidth="true"
                                   SearchPlaceholder="Buscar…" EmptyMessage="Sin resultados" SelectAllLabel="Seleccionar todo"
                                   ClearLabel="Limpiar" CloseLabel="Cerrar" />
                </BbField>
                <BbField>
                    <BbFieldLabel>Estilos / grupos</BbFieldLabel>
                    <BbMultiSelect TValue="string" @bind-Values="_filterGroups" AriaLabel="Estilos / grupos"
                                   Options="@(ToOptions(_filterOptions?.Groups))" Placeholder="Todos los estilos"
                                   Disabled="@(_busy || _filterOptions is null)" MatchTriggerWidth="true"
                                   SearchPlaceholder="Buscar…" EmptyMessage="Sin resultados" SelectAllLabel="Seleccionar todo"
                                   ClearLabel="Limpiar" CloseLabel="Cerrar" />
                </BbField>
                <BbField>
                    <BbFieldLabel>Subestilos</BbFieldLabel>
                    <BbMultiSelect TValue="string" @bind-Values="_filterSubstyles" AriaLabel="Subestilos"
                                   Options="@SubstyleOptions" Placeholder="Todos los subestilos"
                                   Disabled="@(_busy || _filterOptions is null)" MatchTriggerWidth="true"
                                   SearchPlaceholder="Buscar…" EmptyMessage="Sin resultados" SelectAllLabel="Seleccionar todo"
                                   ClearLabel="Limpiar" CloseLabel="Cerrar" />
                </BbField>
            </div>
            <BbTypographyMuted>
                Selecciona uno o varios valores por filtro; sin selección se incluyen todos.
                «Aplicar filtros» combina alternativas del mismo campo y cruza los campos.
                Instrumental o Vocal sin grupo incluye Day y Night.
            </BbTypographyMuted>
            <div class="button-row">
                <BbButton OnClick="ApplyFiltersAsync" Disabled="@(_busy || _filterOptions is null)">Aplicar filtros</BbButton>
                <BbButton Variant="ButtonVariant.Outline" OnClick="ClearFiltersAsync" Disabled="@_busy">
                    Limpiar filtros y volver a años
                </BbButton>
            </div>
        </div>
    </BbCollapsibleContent>
</BbCollapsible>

<nav class="button-row breadcrumb-row" aria-label="Ruta de la biblioteca">
    <BbButton Variant="ButtonVariant.Ghost" OnClick="() => LoadAsync(null, null)" Disabled="@_busy">Años</BbButton>
    @if (_year is not null)
    {
        <span>/</span>
        <BbButton Variant="ButtonVariant.Ghost" OnClick="() => LoadAsync(_year, null)" Disabled="@_busy">@_year</BbButton>
    }
    @if (_style is not null)
    {
        <span>/ @_style</span>
    }
    <BbButton Variant="ButtonVariant.Outline" OnClick="ReloadAsync" Disabled="@_busy">
        Volver a cargar
    </BbButton>
</nav>

@if (_appliedFilter is not null)
{
    <p class="filter-summary" role="status">Filtros aplicados: @FilterSummary</p>
}

@if (_busy)
{
    <div class="busy-indicator" role="status">
        <BbSpinner Size="SpinnerSize.Small" AriaLabel="Cargando biblioteca" />
        <span>Cargando biblioteca…</span>
    </div>
}
@if (_error is not null)
{
    <BbAlert Variant="AlertVariant.Danger" Class="page-alert">
        <BbAlertDescription>@_error</BbAlertDescription>
    </BbAlert>
    <BbLink Href="/settings">Abrir Configuración</BbLink>
}
else if (_listing is not null)
{
    @if (_style is null && _appliedFilter is null)
    {
        <h3 class="section-title">@(_year is null ? "Años" : $"Estilos de {_year}")</h3>
        @if (_listing.Folders.Length == 0)
        {
            <BbAlert Variant="AlertVariant.Info">
                <BbAlertDescription>No hay @(_year is null ? "carpetas de años" : "carpetas de estilos") en este nivel.</BbAlertDescription>
            </BbAlert>
        }
        <div class="button-row">
            @foreach (var folder in _listing.Folders)
            {
                <BbButton Variant="ButtonVariant.Outline" Disabled="@_busy" OnClick="() => OpenFolderAsync(folder)">
                    <Icon><LucideIcon Name="folder" /></Icon>
                    <ChildContent>@folder</ChildContent>
                </BbButton>
            }
        </div>
    }
    else
    {
        <h3 class="section-title">
            @(_appliedFilter is null ? $"{_year} / {_style}" : "Resultados filtrados") · @_listing.Tracks.Length canciones
        </h3>
        <BbDataTable TData="TrackFile" Data="@_listing.Tracks" ShowToolbar="false" ShowPagination="false"
                     AriaLabel="Canciones" Class="tracks-table">
            <Columns>
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Año" Property="@(t => t.Year)"
                                   Visible="@(_appliedFilter is not null)" />
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Estilo" Property="@(t => t.Style)"
                                   Visible="@(_appliedFilter is not null)" />
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Fichero" Property="@(t => t.FileName)">
                    <CellTemplate Context="track">
                        <div class="file-name">@track.FileName</div>
                        @if (track.Warning is not null)
                        {
                            <div class="text-warning text-small" role="status">@track.Warning</div>
                        }
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Título" Property="@(t => Display(t.Title))" />
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Artista"
                                   Property="@(t => Display(string.Join(", ", t.Artists)))" />
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Álbum" Property="@(t => Display(t.Album))" />
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Duración"
                                   Property="@(t => Duration(t.DurationSeconds))" />
                <BbDataTableColumn TData="TrackFile" TValue="string" Header="Reproducción / cola" Id="actions">
                    <CellTemplate Context="track">
                        <div class="row-actions">
                            <IconButton Label="Reproducir" Icon="play" Variant="ButtonVariant.Default"
                                        AriaLabel="@($"Reproducir {track.FileName}")" OnClick="() => PlayTrack(track)" />
                            <IconButton Label="Añadir a la cola" Icon="list-plus"
                                        AriaLabel="@($"Añadir a la cola {track.FileName}")"
                                        OnClick="() => PlayTrack(track, enqueue: true)" />
                            <IconButton Label="Añadir a playlist" Icon="list-music"
                                        AriaLabel="@($"Añadir a playlist {track.FileName}")" OnClick="() => AddToPlaylistAsync(track)" />
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
            </Columns>
            <EmptyTemplate>
                @(_appliedFilter is null ? "No hay ficheros MP3 en este estilo." : "No hay canciones que coincidan con los filtros.")
            </EmptyTemplate>
        </BbDataTable>
        <BbTypographyMuted Class="page-note">
            Los tags ausentes se muestran como «Sin datos». Pulsa el icono de reproducción para escuchar una canción.
        </BbTypographyMuted>
    }
    <AddToPlaylist @ref="_playlistPicker" />
}
