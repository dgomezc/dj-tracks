@page "/tracks"

<PageTitle>Tracks - DJ Tracks</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Tracks</MudText>
<MudText Class="mud-text-secondary mb-4">Explora tu biblioteca por año y estilo.</MudText>

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="Filtros" Expanded="@_filtersOpen" ExpandedChanged="OnFiltersExpandedAsync">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Años" @bind-SelectedValues="_filterYears" MultiSelection="true"
                           Clearable="true" Placeholder="Todos los años" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" Disabled="@(_busy || _filterOptions is null)">
                    @foreach (var year in _filterOptions?.Years ?? [])
                    {
                        <MudSelectItem Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Estilos / grupos" @bind-SelectedValues="_filterGroups" MultiSelection="true"
                           Clearable="true" Placeholder="Todos los estilos" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" Disabled="@(_busy || _filterOptions is null)">
                    @foreach (var group in _filterOptions?.Groups ?? [])
                    {
                        <MudSelectItem Value="@group">@group</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Subestilos" @bind-SelectedValues="_filterSubstyles" MultiSelection="true"
                           Clearable="true" Placeholder="Todos los subestilos" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" Disabled="@(_busy || _filterOptions is null)">
                    <MudSelectItem T="string" Value="@("Instrumental")">Instrumental</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Vocal")">Vocal</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
        <MudText Typo="Typo.body2" Class="mud-text-secondary my-2">
            Selecciona uno o varios valores por filtro; sin selección se incluyen todos.
            Los filtros se combinan al pulsar Aplicar. Instrumental o Vocal sin grupo incluye Day y Night.
        </MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap">
            <MudButton OnClick="ApplyFiltersAsync" Disabled="@(_busy || _filterOptions is null)"
                       Variant="Variant.Filled" Color="Color.Primary">Aplicar filtros</MudButton>
            <MudButton OnClick="ClearFiltersAsync" Disabled="@_busy">Limpiar filtros y volver a años</MudButton>
        </MudStack>
    </MudExpansionPanel>
</MudExpansionPanels>

<MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-4">
    <MudButton OnClick="() => LoadAsync(null, null)" Disabled="@_busy">Años</MudButton>
    @if (_year is not null)
    {
        <MudText Class="align-self-center">/</MudText>
        <MudButton OnClick="() => LoadAsync(_year, null)" Disabled="@_busy">@_year</MudButton>
    }
    @if (_style is not null)
    {
        <MudText Class="align-self-center">/ @_style</MudText>
    }
    <MudButton OnClick="ReloadAsync" Disabled="@_busy" Variant="Variant.Outlined">
        Volver a cargar
    </MudButton>
</MudStack>

@if (_appliedFilter is not null)
{
    <MudText Class="mb-3" role="status">Filtros aplicados: @FilterSummary</MudText>
}

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" aria-label="Cargando biblioteca" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" role="alert">@_error</MudAlert>
    <MudLink Href="/settings">Abrir Configuración</MudLink>
}
else if (_listing is not null)
{
    @if (_style is null && _appliedFilter is null)
    {
        <MudText Typo="Typo.h6" Class="mb-2">@(_year is null ? "Años" : $"Estilos de {_year}")</MudText>
        @if (_listing.Folders.Length == 0)
        {
            <MudAlert Severity="Severity.Info">No hay @(_year is null ? "carpetas de años" : "carpetas de estilos") en este nivel.</MudAlert>
        }
        <MudStack Row="true" Wrap="Wrap.Wrap">
            @foreach (var folder in _listing.Folders)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Folder"
                           Disabled="@_busy" OnClick="() => OpenFolderAsync(folder)">@folder</MudButton>
            }
        </MudStack>
    }
    else
    {
        <MudText Typo="Typo.h6" Class="mb-2">
            @(_appliedFilter is null ? $"{_year} / {_style}" : "Resultados filtrados") · @_listing.Tracks.Length canciones
        </MudText>
        <MudTable Items="@_listing.Tracks" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                @if (_appliedFilter is not null)
                {
                    <MudTh>Año</MudTh>
                    <MudTh>Estilo</MudTh>
                }
                <MudTh>Fichero</MudTh>
                <MudTh>Título</MudTh>
                <MudTh>Artista</MudTh>
                <MudTh>Álbum</MudTh>
                <MudTh>Duración</MudTh>
            </HeaderContent>
            <RowTemplate>
                @if (_appliedFilter is not null)
                {
                    <MudTd DataLabel="Año">@context.Year</MudTd>
                    <MudTd DataLabel="Estilo">@context.Style</MudTd>
                }
                <MudTd DataLabel="Fichero">
                    <MudStack Spacing="1">
                        <MudText Style="overflow-wrap: anywhere">@context.FileName</MudText>
                        @if (context.Warning is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" role="status">@context.Warning</MudText>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Título">@Display(context.Title)</MudTd>
                <MudTd DataLabel="Artista">@Display(string.Join(", ", context.Artists))</MudTd>
                <MudTd DataLabel="Álbum">@Display(context.Album)</MudTd>
                <MudTd DataLabel="Duración">@Duration(context.DurationSeconds)</MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>@(_appliedFilter is null ? "No hay ficheros MP3 en este estilo." : "No hay canciones que coincidan con los filtros.")</MudText>
            </NoRecordsContent>
        </MudTable>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
            Los tags ausentes se muestran como «Sin datos». La reproducción llegará en F1.3.
        </MudText>
    }
}
