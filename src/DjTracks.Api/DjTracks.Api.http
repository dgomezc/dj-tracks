@DjTracks.Api_HostAddress = http://localhost:5247

GET {{DjTracks.Api_HostAddress}}/api/library/remember?category=Cortas
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/remember?category=Largas
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/remember?category=Cortas&fileName=Artista%20-%20Tema.mp3
Range: bytes=0-1023

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/remember/waveform?category=Cortas&fileName=Artista%20-%20Tema.mp3
Accept: application/x-ndjson

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/remember/artwork?category=Cortas&fileName=Artista%20-%20Tema.mp3
Accept: application/json

###

# Lee el primer TXT compatible de la carpeta del MP3; null/null si no hay ninguno.
GET {{DjTracks.Api_HostAddress}}/api/library/sessions/tracklist?year=2026&session=Nombre%20de%20sesión&fileName=Sesión.mp3
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/sessions
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/sessions?year=2026&session=2026-10-28%20-%20Sesión
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/sessions?year=2026&session=2026-10-28%20-%20Sesión&fileName=Sesión.mp3
Range: bytes=0-1023

###

GET {{DjTracks.Api_HostAddress}}/api/library/tracks
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/sessions/waveform?year=2026&session=Nombre%20de%20sesión&fileName=Sesión.mp3
Accept: application/x-ndjson

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/sessions/artwork?year=2026&session=Nombre%20de%20sesión&fileName=Sesión.mp3
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/tracks/filter-options
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/tracks/search?year=2025&year=2026&group=Day&group=Night&substyle=Instrumental
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/tracks?year=2025&style=Day%20Instrumental&fileName=Artist%20-%20Track.mp3
Range: bytes=0-1023

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/tracks/waveform?year=2025&style=Day%20Instrumental&fileName=Artist%20-%20Track.mp3
Accept: application/x-ndjson

###

GET {{DjTracks.Api_HostAddress}}/api/settings
Accept: application/json

###

# Devuelve dataUrl null si el MP3 no contiene ninguna imagen incrustada.
GET {{DjTracks.Api_HostAddress}}/api/streaming/tracks/artwork?year=2025&style=Day%20Instrumental&fileName=Artist%20-%20Track.mp3
Accept: application/json

###

# Crear y copiar el id de la respuesta en playlistId.
@playlistId = 00000000-0000-0000-0000-000000000000
@entryId = 00000000-0000-0000-0000-000000000000

POST {{DjTracks.Api_HostAddress}}/api/playlists
Content-Type: application/json

{"name": "Mi mezcla"}

###

GET {{DjTracks.Api_HostAddress}}/api/playlists

###

GET {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}

###

PUT {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}
Content-Type: application/json

{"name": "Mi mezcla renombrada"}

###

POST {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}/tracks
Content-Type: application/json

{"track": {"library": "Tracks", "year": "2025", "style": "Day Instrumental", "fileName": "Artist - Track.mp3"}}

###

POST {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}/tracks
Content-Type: application/json

{"track": {"library": "Remember", "category": "Cortas", "fileName": "Recuerdo.mp3"}}

###

# Resuelve las canciones actuales antes de incorporarlas a la cola en la UI.
GET {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}/playback

###

DELETE {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}/tracks/{{entryId}}

###

# Solo borra el JSON de esta playlist, nunca los MP3 ni la cola.
DELETE {{DjTracks.Api_HostAddress}}/api/playlists/{{playlistId}}

###
