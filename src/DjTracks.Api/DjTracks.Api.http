@DjTracks.Api_HostAddress = http://localhost:5247

GET {{DjTracks.Api_HostAddress}}/api/library/sessions
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/sessions?year=2026&session=2026-10-28%20-%20Sesión
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/sessions?year=2026&session=2026-10-28%20-%20Sesión&fileName=Sesión.mp3
Range: bytes=0-1023

###

GET {{DjTracks.Api_HostAddress}}/api/library/tracks
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/sessions/waveform?year=2026&session=Nombre%20de%20sesión&fileName=Sesión.mp3
Accept: application/x-ndjson

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/sessions/artwork?year=2026&session=Nombre%20de%20sesión&fileName=Sesión.mp3
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/tracks/filter-options
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/library/tracks/search?year=2025&year=2026&group=Day&group=Night&substyle=Instrumental
Accept: application/json

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/tracks?year=2025&style=Day%20Instrumental&fileName=Artist%20-%20Track.mp3
Range: bytes=0-1023

###

GET {{DjTracks.Api_HostAddress}}/api/streaming/tracks/waveform?year=2025&style=Day%20Instrumental&fileName=Artist%20-%20Track.mp3
Accept: application/x-ndjson

###

GET {{DjTracks.Api_HostAddress}}/api/settings
Accept: application/json

###

# Devuelve dataUrl null si el MP3 no contiene ninguna imagen incrustada.
GET {{DjTracks.Api_HostAddress}}/api/streaming/tracks/artwork?year=2025&style=Day%20Instrumental&fileName=Artist%20-%20Track.mp3
Accept: application/json

###
